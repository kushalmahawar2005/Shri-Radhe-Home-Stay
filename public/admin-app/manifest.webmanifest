{
  "id": "/admin/",
  "name": "Shri Radha Villa Stay — Admin",
  "short_name": "Radha Admin",
  "description": "Manage bookings, rooms, dates and photos for Shri Radha Villa Stay.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8f1e3",
  "theme_color": "#1f4d3a",
  "icons": [
    { "src": "/admin-app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/admin-app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Bookings", "url": "/admin/bookings/", "icons": [{ "src": "/admin-app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Availability", "url": "/admin/availability/", "icons": [{ "src": "/admin-app/icon-192.png", "sizes": "192x192" }] }
  ]
}
